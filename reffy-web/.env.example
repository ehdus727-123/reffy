# 웹(PC) 서버 설정. 이 파일을 복사해 .env 로 쓰세요: copy .env.example .env
# 값 뒤에 # 주석을 붙이지 마세요.
# 화면 틀: pc(항상 PC 화면) / mobile / auto(화면 폭에 따라 자동)
LAYOUT=pc
HOST=127.0.0.1
PORT=8100
# DB_URL 이 없으면 data/reffy.db (SQLite) 를 씁니다. 예) mysql+pymysql://user:pw@host:3306/reffy
DB_URL=
# WD tagger 설정 (라벨링 앱과 같은 모델, 처음 실행 때 models/ 로 내려받음)
TAGGER=auto
TAGGER_REPO=SmilingWolf/wd-vit-tagger-v3
# 팀 분류기 파일 (tools/export_classifier.py 로 만듭니다)
CLASSIFIER=models/team_classifier.joblib
# AI 태그를 최종 태그로 인정하는 최소 확률
TAG_THRESHOLD=0.35
