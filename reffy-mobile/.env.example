# 모바일 서버 설정. 이 파일을 복사해 .env 로 쓰세요: copy .env.example .env
# 값 뒤에 # 주석을 붙이지 마세요.
# 항상 모바일 화면으로 보여 줍니다.
LAYOUT=mobile
HOST=127.0.0.1
# 웹 서버(8100)와 겹치지 않는 포트
PORT=8200
# 웹 폴더(reffy-web)의 게시물·계정·모델을 같이 씁니다.
# 모바일만 따로 데이터를 쓰려면 아래 세 줄을 지우세요 (그러면 reffy-mobile/data 를 씁니다).
DATA_DIR=../reffy-web/data
MODEL_DIR=../reffy-web/models
CLASSIFIER=../reffy-web/models/team_classifier.joblib
DB_URL=
TAGGER=auto
TAGGER_REPO=SmilingWolf/wd-vit-tagger-v3
TAG_THRESHOLD=0.35
# 1 이면 로그인·회원가입 화면 없이 게스트 계정으로 바로 들어와요(시연용). 원래대로 하려면 0
NO_LOGIN=1
# 1 이면 이 컴퓨터에서 localhost 로 들어온 사람은 누가 올린 게시물이든 수정·삭제 가능 (공유 링크로 온 사람은 해당 없음)
LOCAL_ADMIN=1
