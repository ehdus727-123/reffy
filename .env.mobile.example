# 모바일 전용 서버용 설정. 모바일 폴더(reffy-mobile)에서 이 파일을 복사해 .env 로 쓰세요. 값 뒤에 # 주석을 붙이지 마세요.
# 항상 모바일 화면으로 보여 줍니다.
LAYOUT=mobile
# PC 서버(8100)와 겹치지 않는 포트
HOST=127.0.0.1
PORT=8200
# PC 폴더(reffy)의 게시물·계정·모델을 같이 씁니다. 따로 쓰려면 아래 세 줄을 지우세요.
DATA_DIR=../reffy/data
MODEL_DIR=../reffy/models
CLASSIFIER=../reffy/models/team_classifier.joblib
DB_URL=
TAGGER=auto
TAGGER_REPO=SmilingWolf/wd-vit-tagger-v3
TAG_THRESHOLD=0.35
