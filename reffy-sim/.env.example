# MariaDB 접속 (비밀번호는 .env 에만 적고 절대 올리지 마세요)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=safebooru

# 인덱스 저장 폴더
OUT_DIR=data

# 확인 화면에서 쓸 로컬 이미지 경로 (없으면 safebooru 원본 URL 로 보여 줌)
# {yyyymm} {id} {ext} 가 채워집니다. 예) C:\safebooru_run\crawler\images\{yyyymm}\{id}.{ext}
IMAGE_PATH=
PORT=8300
